{
  "name": "kanidm-admin",
  "private": true,
  "version": "1.0.0",
  "description": "A modern web-based administration console for Kanidm",
  "license": "MIT",
  "author": "Zyrakq <serg.shehov@tutanota.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyrakq/kanidm-admin.git"
  },
  "bugs": "https://github.com/zyrakq/kanidm-admin/issues",
  "homepage": "https://github.com/zyrakq/kanidm-admin#readme",
  "type": "module",
  "scripts": {
    "watch": "bun run build --watch",
    "build": "bun pre-build && bunx --bun vite build",
