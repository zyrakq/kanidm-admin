# Frontend build settings
#
# Run `bun run build` before server startup.
# Default: false in dev (debug build), true in prod (release build).
# FRONTEND_BUILD=false

# Run `bun watch` in background for live frontend rebuilds.
# Default: true in dev (debug build), false in prod (release build).
# FRONTEND_WATCH=true

# Path to the compiled frontend assets directory.
# Default: <manifest_dir>/ui/dist
# PUBLIC_DIR=/path/to/custom/dist
